@model HomePageDTO

@{
    ViewData["Title"] = "Индивидуална и бизнес фотография";
}

<!-- Carousel Start -->
<div class="container-fluid p-0 pb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="owl-carousel header-carousel position-relative">
        <div class="owl-carousel-item position-relative img-fluid-banner-wrap" data-dot="<img src='img/individualni-fotosesii-lyato-3.jpg'>">
            <img class="img-fluid" src="~/img/individualni-fotosesii-lyato-3.jpg" alt="">
            <div class="owl-carousel-inner">
                <div class="container-fluid carousel-inner-container removeOnMobileFlag">
                    <div class="row justify-content-end text-end">
                        <div class="col-12 col-lg-6 banner-wrap-texts">
                            <h4 class="text-white animated slideInDown banner-subheading">Нашето вдъхновение са вашите спомени</h4>
                            <h1 class="display-2 text-white animated slideInDown banner-heading">Индивидуални фотосесии</h1>
                            <p class="fs-5 fw-medium text-white mb-4 pb-3 banner-text">Подарете време за себе си и преживяване, което улавя най-доброто от вас — момент, превърнат в изкуство</p>
                            <a asp-controller="Photo" asp-action="Portfolio" asp-route-category="@Category.Portrait" class="btn btn-primary py-3 px-5 animated slideInLeft">Портфолио</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            <div class="owl-carousel-item position-relative img-fluid-banner-wrap" data-dot="<img <img src='img/svatbena-fotografiya-4.jpg'>">
            <picture>
                <source media="(orientation: landscape)" srcset="~/img/svatbena-fotografiya-4.jpg">
                <source media="(orientation: portrait)" srcset="~/img/svatbena-fotografiya-5.jpg">
                <img src="/images/banner-landscape.jpg" alt="Banner">
            </picture>
            <div class="owl-carousel-inner">
                <div class="container-fluid carousel-inner-container removeOnMobileFlag">
                    <div class="row justify-content-end text-end">
                        <div class="col-12 col-lg-6 banner-wrap-texts">
                            <h4 class="text-white animated slideInDown banner-subheading">Нашето вдъхновение са вашите спомени</h4>
                            <h1 class="display-1 text-white animated slideInDown banner-heading">Сватбени портрети</h1>
                            <p class="fs-5 fw-medium text-white mb-4 pb-3 banner-text">Ценим тишината между големите събития, усмивките, които не са режисирани, и докосванията, които говорят повече от думите...</p>
                            <a asp-controller ="Photo" asp-action="Portfolio" asp-route-category="@Category.Wedding" class="btn btn-primary py-3 px-5 animated slideInLeft">Портфолио</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="owl-carousel-item position-relative img-fluid-banner-wrap" data-dot="<img src='img/abiturienti-fotosesii-plovdiv-3.jpg'>">
            <picture>
                <source media="(orientation: landscape)" srcset="~/img/abiturienti-fotosesii-plovdiv-3.jpg">
                <source media="(orientation: portrait)" srcset="~/img/abiturienti-fotosesii-plovdiv-4.jpg">
                <img src="/images/banner-landscape.jpg" alt="Banner">
            </picture>
            <div class="owl-carousel-inner">
                <div class="container-fluid carousel-inner-container removeOnMobileFlag">
                    <div class="row justify-content-end text-end">
                        <div class="col-12 col-lg-6 banner-wrap-texts">
                            <h4 class="text-white animated slideInDown banner-subheading">Нашето вдъхновение са вашите спомени</h4>
                            <h1 class="display-2 text-white animated slideInDown banner-heading">Абитуриентски бал</h1>
                            <p class="fs-5 fw-medium text-white mb-4 pb-3 banner-text">Това е вечерта, в която празнувате края на едно важно приключение и началото на следващата голяма стъпка</p>
                            <a asp-controller="Photo" asp-action="Portfolio" asp-route-category="@Category.Prom" class="btn btn-primary py-3 px-5 animated slideInLeft">Портфолио</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="owl-carousel-item position-relative img-fluid-banner-wrap" data-dot="<img src='img/avtomobilna-fotografiya-audi-2.jpg'>">
            <picture>
                <source media="(orientation: landscape)" srcset="~/img/avtomobilna-fotografiya-audi-2.jpg">
                <source media="(orientation: portrait)" srcset="~/img/avtomobilna-fotografiya-audi-2-mobile.jpg">
                <img src="/images/banner-landscape.jpg" alt="Banner">
            </picture>
            <div class="owl-carousel-inner">
                <div class="container-fluid carousel-inner-container removeOnMobileFlag">
                    <div class="row justify-content-end text-end">
                        <div class="col-12 col-lg-6 banner-wrap-texts">
                            <h4 class="text-white animated slideInDown banner-subheading">Нашето вдъхновение са вашите спомени</h4>
                            <h1 class="display-1 text-white animated slideInDown banner-heading">Автомобилна фотография</h1>
                            <p class="fs-5 fw-medium text-white mb-4 pb-3 banner-text">Интериор, екстериор, на паркинг, в движение по улиците - ще получите кадри, отразяващи характера на автомобила ви</p>
                            <a asp-controller="Photo" asp-action="Portfolio" asp-route-category="@Category.Automotive" class="btn btn-primary py-3 px-5 animated slideInLeft">Портфолио</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Carousel End -->
<!-- Service Start -->
<div class="container-fluid my-5 py-5">
    <div class="col-lg-6 wow fadeInUp mx-auto text-center" data-wow-delay="0.5s">
        <div class="h-100">
            <p class="text-primary text-uppercase mb-2">Услуги</p>
            <h1 class="display-6 mb-4">НАШИТЕ УСЛУГИ</h1>
            <p>Във <span class="text-primary"><b>PHOTONIC</b></span> предлагаме разнообразие от фотографски услуги в Пловдив и страната, създадени да уловят и съхранят най-ценните ви моменти.</p>
            <hr class="w-50 mx-auto mb-5 mb-xl-9 border-dark-subtle">
        </div>
    </div>
    <partial name="_GalleryCategories" model="false"></partial>
</div>
<!-- Service End -->
<!-- Partners Start -->
<div class="container-fluid container-partners py-5">
    <div class="container-fluid py-5">
        <div class="text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h4 class="section-title">КЛИЕНТИ</h4>
            <h1 class="display-5 mb-2">НАШИТЕ КЛИЕНТИ</h1>
        </div>
        <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">
            <div class="testimonial-item text-center" data-dot="">
                <a target="_blank" href="https://www.facebook.com/zhrvDetailing"><img src="~/img/partners/zahariev-detailing.jpg" class="text-center mx-auto pb-4" style="width:180px"/></a>
                <h3>Zahariev Detailing</h3>
            </div>
            <div class="testimonial-item text-center" data-dot="">
                <a target="_blank" href="https://vitas.bg/"><img src="~/img/partners/vitas.png" class="text-center mx-auto pb-4" style="width:180px"/></a>
                <h3>Матраци VITAS</h3>
            </div>
            <div class="testimonial-item text-center" data-dot="">
                <a target="_blank" href="https://wesleep.bg/"><img src="~/img/partners/wesleep.png" class="text-center mx-auto pb-4" style="width:180px" /></a>
                <h3>Матраци WeSleep</h3>
            </div>
            <div class="testimonial-item text-center" data-dot="">
                <a target="_blank" href="https://ecomatrak.com/"><img src="~/img/partners/ekomatrak.png" class="text-center mx-auto pb-4" style="width:180px"/></a>
                <h3>Еко Матрак</h3>
            </div>
        </div>
    </div>
</div>
<!-- Partners End -->
<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container py-5">
        <div class="row g-5" style="min-height: 800px !important">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="about-img">
                    <img class="img-fluid" src="img/individualni-fotosesii-lyato-1.jpg" alt="">
                    <img class="img-fluid" src="img/svatbena-fotografiya-1.jpg" alt="">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h4 class="section-title">За нас</h4>
                <h1 class="display-5 mb-4">Професионална фотография от Пловдив</h1>
                <p>Ние сме екип, специализиран в професионалната фотография от град Пловдив. Това разбира се не ни спира да снимаме и в цяла България, тъй като пътуването ни е удоволствие!</p>
                <p class="mb-4">Нашият фокус е върху индивидуалната, бизнес и автомобилната фотография. Мисията ни е да създаваме кадри, които не просто изглеждат добре, а комбинират естетика, емоция и ефективност – както за лични поводи, така и за бизнес нужди.</p>
                <div class="d-flex align-items-center mb-3">
                    <!--<div class="d-flex flex-shrink-0 align-items-center justify-content-center border border-5 border-primary" style="width: 120px; height: 120px;">
                        <h1 class="display-1 mb-n2" data-toggle="counter-up">25</h1>
                    </div>-->
                    <!--<div class="ps-4">
                        <h3>Years</h3>
                        <h3>Working</h3>
                        <h3 class="mb-0">Experience</h3>
                    </div>-->
                </div>
                <a class="btn btn-primary py-3 px-5" asp-controller="Home" asp-action="About">Научете повече</a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Team Start -->
<div class="container-xxl py-5">
    <div class="container py-5">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h4 class="section-title">Актуално</h4>
            <h1 class="display-5 mb-4">ПОСЛЕДНИТЕ НОВИНИ И ПУБЛИКАЦИИ</h1>
        </div>
        <div class="row g-0 team-items">
            @foreach (Article article in Model?.Articles ?? new List<Article>())
            {
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="team-item position-relative">
                        <div class="position-relative">
                            <img class="img-fluid" src="~/resources/images/@(article.ImageName)" alt="">
                            <!--<div class="team-social text-center">
                                <a class="btn btn-square" href=""><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-square" href=""><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-square" href=""><i class="fab fa-instagram"></i></a>
                            </div>-->
                        </div>
                        <div class="bg-light text-center p-4 dynamic-content-title-wrap">
                            <h3 class="mt-2"><a class="text-dark" asp-action="Content" asp-controller="Blog" asp-route-id="@article?.Id">@(article?.Title ?? "")</a></h3>
                        </div>
                        <div class="bg-primary text-center p-4">
                            <span class="text-light"><a asp-action="AllByCategory" asp-controller="Blog" asp-route-id="@article?.ArticleCategories?.Id" class="text-light">@(article?.ArticleCategories?.Name ?? "")</a> | @(article?.CreatedOn.ToString("dd.MM.yyyy") ?? "") г.</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Team End -->

<!-- Testimonial Start -->
<div class="container-fluid container-testimonials py-5">
    <div class="container-fluid py-5">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h4 class="section-title">Оценки</h4>
            <h1 class="display-5 mb-4">МНЕНИЯ ОТ КЛИЕНТИ</h1>
        </div>
        <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">
            @foreach (Testimony testimony in Model?.Testimonies ?? new List<Testimony>())
            {
                <div class="testimonial-item text-center" data-dot="">
                    <img src="~/img/icons/user-icon.png" class="text-center mx-auto pb-4" style="width:80px"/>
                    <p class="fs-5">@testimony.Content</p>
                    <h3>@((testimony.PersonFirstName ?? "") + " " + (testimony.PersonLastName ?? ""))</h3>
                    <span class="text-primary">
                        @(
                            testimony.PersonJob == string.Empty  || testimony.PersonJob == null ? "Няма професия" : testimony.PersonJob
                        )
                    </span>
                    <div class="star">
                        @for (int i = 0; i < testimony.Stars; i++)
                        {
                            string foo = testimony.PersonJob ?? "";
                            <i class="fa fa-star text-warning"></i>
                        }
                        @for (int i = testimony.Stars + 1; i <= 5; i++)
                        {
                            <i class="fa fa-star"></i>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Testimonial End -->
<div class="pb-5">
    <partial name="_CreateTestimony" model="new CreateTestimonyDTO()"></partial>
</div>

<style>
    .wrap-create-testimony {
        margin-top: 200px;
        padding-bottom: 50px;
        background: #f9f9ff;
    }

    .dynamic-content-title-wrap {
        min-height: 200px !important;
    }

    .carousel-inner-container {
        padding: 0 200px !important;
    }

    .container-partners .owl-dot{
        display: none;
    }

   @@media (max-width: 768px) {
        .img-fluid-banner-wrap{
            min-height: 800px !important;
        }

        .carousel-inner-container .banner-wrap-texts{
            width: 400px !important;
        }

        .carousel-inner-container {
            padding: 0 20px !important;
        }
   }
</style>
                      